{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/sobre", "destination": "/index.html" },
    { "source": "/equipe", "destination": "/index.html" },
    { "source": "/equipe/:slug", "destination": "/index.html" },
    { "source": "/areas-de-atuacao", "destination": "/index.html" },
    { "source": "/metodologia", "destination": "/index.html" },
    { "source": "/cases", "destination": "/index.html" },
    { "source": "/conteudos", "destination": "/index.html" },
    { "source": "/contato", "destination": "/index.html" },
    { "source": "/aplicacaocosmmus", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
