{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sobre",
      "destination": "/sobre/index.html"
    },
    {
      "source": "/equipe",
      "destination": "/equipe/index.html"
    },
    {
      "source": "/equipe/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/areas-de-atuacao",
      "destination": "/areas-de-atuacao/index.html"
    },
    {
      "source": "/metodologia",
      "destination": "/metodologia/index.html"
    },
    {
      "source": "/cases",
      "destination": "/cases/index.html"
    },
    {
      "source": "/conteudos",
      "destination": "/conteudos/index.html"
    },
    {
      "source": "/contato",
      "destination": "/contato/index.html"
    },
    {
      "source": "/aplicacaocosmmus",
      "destination": "/aplicacaocosmmus/index.html"
    },
    {
      "source": "/diagnostico",
      "destination": "/diagnostico/index.html"
    },
    {
      "source": "/cosmmus-coop",
      "destination": "/cosmmus-coop/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
