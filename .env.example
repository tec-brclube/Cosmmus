# Copie este arquivo para .env.local e preencha os valores.

# OPCIONAL. O endereço padrão da planilha do formulário /aplicacaocosmmus fica no
# código, em DEFAULT_ENDPOINT (components/aplicacao/submit.ts). Preencha abaixo
# somente para apontar para OUTRA planilha em testes. Veja docs/FORMULARIO-SHEETS.md
VITE_SHEETS_ENDPOINT=

# Chave da API do Gemini (usada em outras partes do projeto)
GEMINI_API_KEY=
